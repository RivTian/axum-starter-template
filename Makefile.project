# This is the generated project's Makefile, not the template maintenance driver.
CARGO ?= cargo
PYTHON ?= python3
.DEFAULT_GOAL := help
.PHONY: help preflight build release clean fmt fmt-check lint test release-check service-check check check-process

help:
	@echo 'Service: build / release / fmt / fmt-check / lint / test / release-check / service-check / clean'
	@echo 'check runs the cargo-only gates; check-process adds the real-process ones (POSIX + Python 3.11+).'
	@echo 'Run cargo run --locked; the actual listen address is printed after startup commits.'
preflight:
	@$(PYTHON) -c 'import sys; sys.exit("Python 3.11+ required; set PYTHON=/path/to/python3") if sys.version_info < (3, 11) else None'
build:
	$(CARGO) build --workspace --locked
# The deployable artifact. No -p is needed: the root manifest sets
# default-members = ["app"], so this builds exactly the binary you ship.
# release-check is a different thing entirely — it asserts exit-code contracts.
release:
	$(CARGO) build --release --locked
clean:
	$(CARGO) clean
fmt:
	$(CARGO) fmt --all
fmt-check:
	$(CARGO) fmt --all -- --check
lint:
	$(CARGO) clippy --workspace --all-targets --locked -- -D warnings
test:
	$(CARGO) test --workspace --locked
release-check:
	$(PYTHON) app/tests/check_release.py
service-check:
	@set -e; for profile in debug release; do \
	  for topology in main worker http shared split; do \
	    $(PYTHON) app/tests/check_service.py --profile $$profile --topology $$topology; \
	  done; \
	done
# One ordered recipe avoids concurrent commands mutating a generated workspace.
# The cargo-only gates need no interpreter, so a platform without POSIX signals
# or Python 3.11+ still gets them instead of failing at preflight.
check:
	$(MAKE) fmt-check
	$(MAKE) lint
	$(MAKE) test
	$(MAKE) build
# Real processes, signals and an actual release artifact. Each driver builds
# what it needs, so this is runnable on its own.
check-process:
	$(MAKE) preflight
	$(MAKE) release-check
	$(MAKE) service-check
