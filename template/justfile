# Recipes of {{project-name}}. The binary is selected with --bin, which a dependency can never
# share, unlike a package name. They use no just interpolation: ${CARGO_LOCKED:-} is a shell
# variable, which CI sets to --locked so that builds use the committed Cargo.lock.

set shell := ["bash", "-euo", "pipefail", "-c"]

# List the recipes.
default:
    @just --list

# Run the service with the example configuration.
run:
    cargo run --bin {{project-name}} -- run --config config/example.toml

# Check the example configuration and print every key's value and source.
check-config:
    cargo run --bin {{project-name}} -- check-config --config config/example.toml

# Every quality check, in the order CI runs them.
check: fmt-check lint test doc typos machete deny{% if with_ci %} workflows{% endif %}

# Format the code.
fmt:
    cargo fmt --all

# Check the formatting.
fmt-check:
    cargo fmt --all --check

# Clippy on every target, with default and with all features.
lint:
    cargo clippy --workspace --all-targets ${CARGO_LOCKED:-} -- -D warnings
    cargo clippy --workspace --all-targets --all-features ${CARGO_LOCKED:-} -- -D warnings

# Tests and doctests.
test:
    cargo nextest run --workspace ${CARGO_LOCKED:-}
    cargo test --workspace --doc ${CARGO_LOCKED:-}

# API documentation, without warnings.
doc:
    RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps ${CARGO_LOCKED:-}

# Spelling.
typos:
    typos

# Unused dependencies. --with-metadata, because the library targets are renamed to svc_*.
machete:
    cargo machete --with-metadata

# Licenses, security advisories and sources of the dependencies.
deny:
    cargo deny check
{%- if with_ci %}

# The GitHub Actions workflows.
workflows:
    actionlint .github/workflows/*.yml
{%- endif %}

# The oldest supported Rust.
msrv:
    cargo +1.88 check --workspace --all-targets ${CARGO_LOCKED:-}

# Run with tokio-console support; connect with `tokio-console`.
console:
    RUSTFLAGS="--cfg tokio_unstable" cargo run --bin {{project-name}} --features {{project-name}}/console -- run --config config/example.toml

# The console feature: its error without the cfg, then a build with the cfg, in a target
# directory of its own so the cfg never reaches the main build cache.
console-check:
    cargo nextest run -p {{project-name}}-telemetry --features console ${CARGO_LOCKED:-} -E 'test(the_console_needs_tokio_unstable)'
    RUSTFLAGS="--cfg tokio_unstable" CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}/console" cargo check --bin {{project-name}} --features {{project-name}}/console ${CARGO_LOCKED:-}

# A release archive: dist/{{project-name}}-<version>-<target>.tar.gz with the binary
# (`.exe` on Windows), README.md, THIRD_PARTY_NOTICES.md and LICENSE (when there is one), and
# its SHA-256 next to it, which `shasum -a 256 -c` or `sha256sum -c` checks.
package:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo build --release ${CARGO_LOCKED:-} --bin {{project-name}}
    target="$(rustc -vV | sed -n 's/^host: //p')"
    version="$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)"
    name="{{project-name}}-${version}-${target}"
    exe=""
    case "$target" in *windows*) exe=".exe" ;; esac
    rm -rf "dist/${name}" && mkdir -p "dist/${name}"
    cp "${CARGO_TARGET_DIR:-target}/release/{{project-name}}${exe}" README.md THIRD_PARTY_NOTICES.md "dist/${name}/"
    if [ -f LICENSE ]; then cp LICENSE "dist/${name}/"; fi
    tar -C dist -czf "dist/${name}.tar.gz" "${name}"
    # Git for Windows has sha256sum but may lack shasum; both write the same line.
    if command -v shasum >/dev/null; then sum=(shasum -a 256); else sum=(sha256sum); fi
    (cd dist && "${sum[@]}" "${name}.tar.gz" > "${name}.tar.gz.sha256")
    echo "dist/${name}.tar.gz"
{%- if with_docker %}

# The container image, tagged {{project-name}}:dev, with the current commit as its git SHA;
# `unknown` before the first commit.
docker-build:
    docker build --build-arg GIT_SHA="$(git rev-parse --verify --quiet HEAD || echo unknown)" -t {{project-name}}:dev .
{%- endif %}
